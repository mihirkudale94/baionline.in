# Copy this file to .env and insert a newly generated OpenRouter key.
OPENROUTER_API_KEY=replace_with_new_openrouter_key
OPENROUTER_MODEL=openrouter/free

# Optional: only needed for Google embeddings.
GEMINI_API_KEY=

# Optional: only needed for Supabase vector search.
SUPABASE_URL=
SUPABASE_KEY=

# Razorpay — drives two flows: membership subscriptions on /membership and
# paid sponsorship listings on /sponsors-inquiry.
# Get these from Razorpay Dashboard > Settings > API Keys. Use the rzp_test_*
# pair until the account is activated, then swap in the rzp_live_* pair.
# Leave both blank to disable online payment: the membership page then shows
# only the Demand Draft / NEFT route, and the sponsorship checkout hides
# itself. The secret is never sent to the browser.
#
# NOTE: keep these on the rzp_test_* pair until the placeholder sponsorship
# prices in backend/routers/sponsors.py have been replaced with the
# committee-approved rate card.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
