# Copy this file to .env for local development, or set the same names in the
# host's build environment. Everything here is baked into the built bundle and
# is therefore public — never put a secret in this file.

# Where the API lives. Leave blank to use the defaults in src/services/api.js:
# http://localhost:8000/api under `npm run dev`, /api once the backend serves
# the built frontend.
VITE_API_BASE_URL=

# Google reCAPTCHA v2 SITE key for the contact form. Its matching secret goes
# in backend/.env as RECAPTCHA_SECRET_KEY. Leave blank to hide the widget.
VITE_RECAPTCHA_SITE_KEY=
